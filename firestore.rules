rules_version = '2';

// =============================================================================
// Royal Sales IA — Firestore Security Rules (multi-tenant)
// -----------------------------------------------------------------------------
// Identity model (see lib/firebase/membership.ts and MULTITENANT.md):
//   memberships/{authUid}  → { workspaceId, role, userId, email }
//   users/{userId}         → team profile (may exist before the person signs up)
//
// Isolation is ALWAYS by `workspaceId`. A document without `workspaceId`
// (legacy) is only readable by super_admin, who migrates it from the app.
//
// Roles:
//   super_admin  → global read/write on everything
//   client_admin → full access inside their workspace
//   manager      → full access inside their workspace, except: cannot create
//                  or delete workspaces, cannot change roles to super_admin
//   sales_rep    → reads/writes ONLY leads assigned to them; reads campaigns,
//                  clients and team of their workspace
//   viewer       → read-only inside their workspace (no writes)
//
// Publish with: Firebase Console → Firestore → Rules → paste → Publish
// (or `firebase deploy --only firestore:rules` if you use the CLI).
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------ helpers
    function signedIn() {
      return request.auth != null;
    }

    function membershipPath() {
      return /databases/$(database)/documents/memberships/$(request.auth.uid);
    }

    function hasMembership() {
      return signedIn() && exists(membershipPath());
    }

    function me() {
      return get(membershipPath()).data;
    }

    function role() {
      return me().role;
    }

    function myWorkspace() {
      return me().workspaceId;
    }

    /** users.id of the caller's team profile. */
    function myUserId() {
      return me().userId;
    }

    function isSuperAdmin() {
      return hasMembership() && role() == 'super_admin';
    }

    /**
     * A deactivated member keeps their Firebase session but loses the app.
     * The flag lives on the membership — the document these rules already
     * read — so revoking access costs no extra document read and cannot be
     * bypassed by a stale client. Absent means active (legacy memberships).
     */
    function membershipIsActive() {
      return me().get('status', 'active') != 'inactive';
    }

    /**
     * Caller belongs to workspace `ws` AND is still active. Super admin is
     * excluded on purpose and never passes through here, so deactivating
     * somebody can never lock the super admin out.
     */
    function inWorkspace(ws) {
      return hasMembership() && ws is string && myWorkspace() == ws && membershipIsActive();
    }

    function isWsAdmin(ws) {
      return inWorkspace(ws) && role() in ['client_admin', 'manager'];
    }

    /**
     * Distribuidor (client_admin) and Asistente (manager) hold the SAME
     * operational rights inside their workspace: settings, memberships,
     * deletions, archiving. What only the super admin may do stays with
     * isSuperAdmin(); Telemarketing (sales_rep) keeps its own narrower set.
     */
    function isWsClientAdmin(ws) {
      return inWorkspace(ws) && role() in ['client_admin', 'manager'];
    }

    function isWsMember(ws) {
      return inWorkspace(ws) && role() in ['client_admin', 'manager', 'sales_rep', 'viewer'];
    }

    function isWsRep(ws) {
      return inWorkspace(ws) && role() == 'sales_rep';
    }

    function validRole(r) {
      return r in ['super_admin', 'client_admin', 'manager', 'sales_rep', 'viewer'];
    }

    /** Ventas / Reclutamiento. Never used for access decisions — only validated. */
    function validLeadType(v) {
      return v in ['sales', 'recruiting'];
    }

    // --- Lead pipelines. Must stay in sync with PIPELINES in lib/constants.ts.
    function salesStages() {
      return ['new_lead', 'contact', 'contacted', 'interested',
              'appointment', 'follow_up', 'sale', 'not_interested'];
    }

    function recruitingStages() {
      return ['rec_new', 'rec_contact', 'rec_contacted', 'rec_qualified', 'rec_interview',
              'rec_orientation', 'rec_follow_up', 'rec_hired', 'rec_disqualified'];
    }

    /** First stage of each pipeline: the only stage a type change may land on. */
    function initialStageFor(type) {
      return type == 'sales' ? 'new_lead' : 'rec_new';
    }

    /**
     * A sales lead can only ever hold a sales stage, and a recruiting lead a
     * `rec_*` stage. Enforced server-side so a direct SDK write cannot produce
     * an incoherent document.
     */
    function stageMatchesType(type, stage) {
      return (type == 'sales' && stage in salesStages())
          || (type == 'recruiting' && stage in recruitingStages());
    }

    /** Keys added, removed or modified by this write. */
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /** Field `f` is not being modified by this write. */
    function unchanged(f) {
      return request.resource.data[f] == resource.data[f];
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // -------------------------------------------------------------- workspaces
    match /workspaces/{wsId} {

      // ---- Seat ledger: 2 Distribuidores, 2 Asistentes, 2 Telemarketing.
      // Rules cannot count documents, so the workspace carries who holds each
      // seat. Every change is declared in `seatOps` so it can be verified
      // against the team profile written in the same transaction.

      function seatRoles() {
        return ['client_admin', 'manager', 'sales_rep'];
      }

      function seatsAfter() {
        return request.resource.data.seats;
      }

      function seatsBefore() {
        return resource.data.get('seats', {'client_admin': [], 'manager': [], 'sales_rep': []});
      }

      function hadLedger() {
        return resource.data.keys().hasAny(['seats']);
      }

      function validSeatsShape() {
        return seatsAfter() is map
          && seatsAfter().keys().hasAll(seatRoles())
          && seatsAfter().keys().hasOnly(seatRoles())
          && seatsAfter().client_admin is list
          && seatsAfter().manager is list
          && seatsAfter().sales_rep is list;
      }

      /** Never more than 2 per role once a seat is being taken. */
      function seatLimitsRespected() {
        return seatsAfter().client_admin.size() <= 2
          && seatsAfter().manager.size() <= 2
          && seatsAfter().sales_rep.size() <= 2;
      }

      /** The profile this seat change is about, as it ends up after the batch. */
      function seatUser(op) {
        return getAfter(/databases/$(database)/documents/users/$(op.userId)).data;
      }

      function seatUserExists(op) {
        return existsAfter(/databases/$(database)/documents/users/$(op.userId));
      }

      /**
       * A declared op must be what really happened: an added holder ends up
       * with that role and holding a seat (invited or active); a removed
       * holder ends up inactive or with another role. Always in THIS workspace.
       */
      function seatOpIsHonest(op) {
        return op.kind in ['add', 'remove']
          && op.role in seatRoles()
          && op.userId is string
          && seatUserExists(op)
          && seatUser(op).workspaceId == wsId
          && (
            (op.kind == 'add'
              && seatsAfter()[op.role].hasAll([op.userId])
              && seatUser(op).role == op.role
              && seatUser(op).status in ['invited', 'active'])
            || (op.kind == 'remove'
              && !seatsAfter()[op.role].hasAll([op.userId])
              && (seatUser(op).status == 'inactive' || seatUser(op).role != op.role))
          );
      }

      /**
       * The ledger may only change by the declared ops — at most two, which is
       * a role change (remove from A, add to B). Each role list may differ from
       * before by at most the declared user, so nobody can quietly drop other
       * holders to make room.
       */
      function seatOpsAreHonest() {
        return request.resource.data.seatOps is list
          && request.resource.data.seatOps.size() >= 1
          && request.resource.data.seatOps.size() <= 2
          && seatOpIsHonest(request.resource.data.seatOps[0])
          && (request.resource.data.seatOps.size() == 1
              || seatOpIsHonest(request.resource.data.seatOps[1]));
      }

      function roleListOnlyChangedByOps(r) {
        return seatsAfter()[r].toSet().difference(seatsBefore()[r].toSet()).size()
              + seatsBefore()[r].toSet().difference(seatsAfter()[r].toSet()).size()
            <= (request.resource.data.seatOps[0].role == r ? 1 : 0)
              + (request.resource.data.seatOps.size() == 2 && request.resource.data.seatOps[1].role == r ? 1 : 0);
      }

      /**
       * First write of the ledger on a legacy workspace: it is built from the
       * existing team, so it may hold anything the team already had — but the
       * declared op still has to be honest and the limits still bind whatever
       * is being ADDED. The super admin's "recalcular cupos" tool also lands
       * here and may exceed 2 only to reflect an already over-limit team.
       */
      function seatLedgerWriteIsValid() {
        return validSeatsShape()
          && seatOpsAreHonest()
          && (hadLedger()
                ? (seatLimitsRespected()
                   && roleListOnlyChangedByOps('client_admin')
                   && roleListOnlyChangedByOps('manager')
                   && roleListOnlyChangedByOps('sales_rep'))
                : true);
      }

      allow read: if isSuperAdmin() || isWsMember(wsId);
      allow create, delete: if isSuperAdmin();
      // The company profile a distributor fills in from Configuración. The
      // whitelist is what keeps a client_admin from touching `plan`, `status`
      // or `createdAt`; a manager or viewer is not listed here at all.
      allow update: if isSuperAdmin()
        || (isWsClientAdmin(wsId) && onlyChanges([
              'name', 'logoColor', 'ownerEmail', 'updatedAt',
              'phone', 'city', 'state', 'timezone'
            ]))
        // Seat changes: whoever may manage the team (Distribuidor, Asistente)
        // may move the ledger, and only through honest, declared ops.
        || (isWsAdmin(wsId)
            && onlyChanges(['seats', 'seatOps', 'updatedAt'])
            && seatLedgerWriteIsValid());
    }

    // ------------------------------------------------------------- memberships
    // Doc id == Firebase Auth UID.
    match /memberships/{uid} {
      allow get: if signedIn() && (
        uid == request.auth.uid
        || isSuperAdmin()
        || isWsAdmin(resource.data.workspaceId)
      );
      allow list: if isSuperAdmin() || isWsAdmin(resource.data.workspaceId);

      // Super admin can grant any membership.
      // Anyone else can only CLAIM their own invitation: the values written
      // must match an unclaimed `users` profile with their (verified) email.
      allow create: if isSuperAdmin() || (
        uid == request.auth.uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasAll(['workspaceId', 'role', 'userId', 'email', 'createdAt'])
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.role != 'super_admin'
        && validRole(request.resource.data.role)
        && exists(/databases/$(database)/documents/users/$(request.resource.data.userId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.authUid == null
        && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.email == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.workspaceId == request.resource.data.workspaceId
        && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.role == request.resource.data.role
      );

      allow update: if isSuperAdmin() || (
        isWsClientAdmin(resource.data.workspaceId)
        && unchanged('workspaceId') && unchanged('userId') && unchanged('email')
        && request.resource.data.role != 'super_admin'
        && validRole(request.resource.data.role)
      );
      allow delete: if isSuperAdmin() || isWsClientAdmin(resource.data.workspaceId);
    }

    // ------------------------------------------------------------------- users
    // Team profiles. Legacy docs (no workspaceId) → super admin only.
    match /users/{userId} {

      /** The workspace ledger as it ends up after this batch. */
      function ledgerAfter() {
        return getAfter(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data;
      }

      function ledgerHasSeatsAfter() {
        return ledgerAfter().keys().hasAny(['seats']);
      }

      function seatRoleAfter() {
        return request.resource.data.role in ['client_admin', 'manager', 'sales_rep'];
      }

      /**
       * A profile that holds a seat (invited/active, seat role) must be listed
       * in the ledger; an inactive one must not. Checked whenever the role or
       * status moves, so the ledger and the team can never disagree — and a
       * plain name/colour edit skips it, which keeps legacy workspaces usable.
       */
      function seatConsistentAfter() {
        return !seatRoleAfter()
          || (request.resource.data.status == 'inactive'
                ? (!ledgerHasSeatsAfter()
                   || !ledgerAfter().seats[request.resource.data.role].hasAll([userId]))
                : (ledgerHasSeatsAfter()
                   && ledgerAfter().seats[request.resource.data.role].hasAll([userId])));
      }

      function roleOrStatusChanges() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']);
      }

      allow read: if isSuperAdmin()
        || isWsMember(resource.data.workspaceId)
        // Needed for the invitation lookup before a membership exists.
        || (signedIn() && resource.data.email == request.auth.token.email.lower());

      // An invitation reserves a seat: the profile is born listed in the ledger
      // written by the same transaction. Only the three seat roles are
      // invitable — `viewer` is legacy and stays out of new invitations.
      allow create: if isSuperAdmin() || (
        isWsAdmin(request.resource.data.workspaceId)
        && request.resource.data.role != 'super_admin'
        && validRole(request.resource.data.role)
        && seatRoleAfter()
        && request.resource.data.status == 'invited'
        && request.resource.data.authUid == null
        && seatConsistentAfter()
      );

      allow update: if isSuperAdmin()
        // Workspace admins manage their team, but cannot move a profile to
        // another workspace nor escalate anyone to super_admin. A role or
        // status change must be mirrored in the seat ledger.
        || (isWsAdmin(resource.data.workspaceId)
            && unchanged('workspaceId')
            && request.resource.data.role != 'super_admin'
            && validRole(request.resource.data.role)
            && (!roleOrStatusChanges() || seatConsistentAfter()))
        // A member may edit their own display fields.
        || (hasMembership() && resource.data.authUid == request.auth.uid
            && onlyChanges(['name', 'avatarColor', 'updatedAt']))
        // Claiming an invitation: only authUid/status/updatedAt change.
        || (signedIn()
            && request.auth.token.email_verified == true
            && resource.data.authUid == null
            && resource.data.email == request.auth.token.email.lower()
            && request.resource.data.authUid == request.auth.uid
            && onlyChanges(['authUid', 'status', 'updatedAt']));

      allow delete: if isSuperAdmin() || isWsClientAdmin(resource.data.workspaceId);
    }

    // ----------------------------------------------------------------- clients
    // Commercial accounts for campaign attribution: administrative data.
    // Telemarketing works prospects and never needs this, so it is not listed.
    match /clients/{clientId} {
      allow read: if isSuperAdmin()
        || (inWorkspace(resource.data.workspaceId) && role() in ['client_admin', 'manager', 'viewer']);
      allow create: if isSuperAdmin() || isWsAdmin(request.resource.data.workspaceId);
      allow update: if isSuperAdmin()
        || (isWsAdmin(resource.data.workspaceId) && unchanged('workspaceId'));
      allow delete: if isSuperAdmin() || isWsClientAdmin(resource.data.workspaceId);
    }

    // --------------------------------------------------------------- campaigns
    match /campaigns/{campaignId} {
      allow read: if isSuperAdmin() || isWsMember(resource.data.workspaceId);
      // `objective` (clientes / candidatos) is required on new campaigns.
      allow create: if validLeadType(request.resource.data.objective)
        && (isSuperAdmin() || isWsAdmin(request.resource.data.workspaceId));
      allow update: if isSuperAdmin()
        || (isWsAdmin(resource.data.workspaceId) && unchanged('workspaceId'));
      allow delete: if isSuperAdmin() || isWsClientAdmin(resource.data.workspaceId);
    }

    // ----------------------------------------------------------- appointments
    // Operational calendar. An appointment belongs to exactly ONE workspace
    // and always references a real lead. Mirrors the lead permissions: admins
    // and managers act on their whole workspace, a rep only on meetings
    // assigned to them, a viewer reads and never writes.
    match /appointments/{appointmentId} {

      function validAppointmentStatus(v) {
        return v in ['scheduled', 'completed', 'no_show', 'cancelled'];
      }

      function validAppointmentType(v) {
        return v in ['demo', 'follow_up', 'closing', 'interview', 'orientation', 'other'];
      }

      /**
       * Meeting types per pipeline. Must stay in sync with APPOINTMENT_TYPES
       * in lib/appointments.ts: a sales lead can never hold an interview and a
       * candidate can never hold a product demo.
       */
      function salesAppointmentTypes() {
        return ['demo', 'follow_up', 'closing', 'other'];
      }

      function recruitingAppointmentTypes() {
        return ['interview', 'orientation', 'follow_up', 'other'];
      }

      function typeMatchesLeadType(leadType, type) {
        return (leadType == 'sales' && type in salesAppointmentTypes())
            || (leadType == 'recruiting' && type in recruitingAppointmentTypes());
      }

      /**
       * A Royal Prestige demo happens at the customer's home, so a sales demo
       * cannot exist without a physical address. Every other type may have one
       * or not. Must stay in sync with requiresLocation in lib/appointments.ts.
       */
      function locationIsRequired() {
        return request.resource.data.leadType == 'sales'
            && request.resource.data.type == 'demo';
      }

      function hasLocation() {
        return request.resource.data.keys().hasAny(['location']);
      }

      /**
       * A stored address is complete or it is not stored at all: half an
       * address helps nobody find the house.
       */
      function validLocationShape() {
        return !hasLocation() || (
          request.resource.data.location is map
          && request.resource.data.location.keys().hasAll(['addressLine1', 'city', 'state', 'postalCode'])
          && request.resource.data.location.keys().hasOnly(['addressLine1', 'addressLine2', 'city', 'state', 'postalCode'])
          && request.resource.data.location.addressLine1 is string
          && request.resource.data.location.addressLine1.size() > 0
          && request.resource.data.location.city is string
          && request.resource.data.location.city.size() > 0
          && request.resource.data.location.state is string
          && request.resource.data.location.state.size() > 0
          && request.resource.data.location.postalCode is string
          && request.resource.data.location.postalCode.size() > 0
        );
      }

      function locationRuleMet() {
        return validLocationShape() && (!locationIsRequired() || hasLocation());
      }

      /**
       * Tenant, lead link, authorship and the lead snapshot never change after
       * creation. `leadType` and `leadName` are frozen too: they were verified
       * against the real lead at creation time, so letting them drift later
       * would defeat that check.
       */
      function apptImmutablesKept() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['workspaceId', 'leadId', 'createdBy', 'createdAt', 'leadType', 'leadName']);
      }

      function validAppointmentShape() {
        return request.resource.data.keys().hasAll([
              'workspaceId', 'leadId', 'leadName', 'leadType', 'assignedToId',
              'scheduledAt', 'durationMinutes', 'type', 'status', 'createdBy',
              'createdAt', 'updatedAt'
            ])
          && request.resource.data.keys().hasOnly([
              'workspaceId', 'leadId', 'leadName', 'leadType', 'assignedToId',
              'scheduledAt', 'durationMinutes', 'type', 'status', 'notes', 'location',
              'createdBy', 'createdAt', 'updatedAt'
            ])
          && request.resource.data.workspaceId is string
          && request.resource.data.workspaceId.size() > 0
          && request.resource.data.leadId is string
          && request.resource.data.leadId.size() > 0
          && request.resource.data.leadName is string
          && validLeadType(request.resource.data.leadType)
          && request.resource.data.assignedToId is string
          && request.resource.data.scheduledAt is string
          && request.resource.data.scheduledAt.size() > 0
          && request.resource.data.durationMinutes is number
          && request.resource.data.durationMinutes > 0
          && validAppointmentType(request.resource.data.type)
          // The type must belong to its own pipeline in EVERY write, not just
          // on create: `leadType` is immutable, so checking the incoming body
          // is enough and it closes the door to turning a sales demo into a
          // recruiting interview through an update.
          && typeMatchesLeadType(request.resource.data.leadType, request.resource.data.type)
          && validAppointmentStatus(request.resource.data.status)
          && locationRuleMet()
          && request.resource.data.createdBy is string;
      }

      /** The lead this appointment points at, read server-side. */
      function referencedLead() {
        return get(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data;
      }

      /**
       * The referenced lead must really exist AND live in the same workspace.
       * Read server-side, so a tampered body cannot attach a meeting to
       * another distributor's lead.
       */
      function leadIsInSameWorkspace() {
        return exists(/databases/$(database)/documents/leads/$(request.resource.data.leadId))
          && referencedLead().workspaceId == request.resource.data.workspaceId;
      }

      /**
       * The appointment must describe the lead it really points at: the whole
       * snapshot is verified against the real document — `leadName` and
       * `leadType` must match it, and `type` must belong to that pipeline.
       * `leadName` matters because the agenda renders it without reading the
       * lead (a rep cannot read leads that are not theirs), so an unverified
       * name would be a label nobody could contradict.
       */
      function appointmentMatchesLead() {
        return request.resource.data.leadName == referencedLead().name
          && request.resource.data.leadType == referencedLead().get('leadType', 'sales')
          && typeMatchesLeadType(request.resource.data.leadType, request.resource.data.type);
      }

      /**
       * A rep may only schedule on a lead that is actually theirs. Without
       * this, knowing a colleague's leadId would be enough to attach meetings
       * to leads they cannot even read.
       */
      function repOwnsReferencedLead() {
        return referencedLead().assignedToId == myUserId();
      }

      // Admins/managers/viewers see the whole workspace; a rep only their own.
      // (A rep's client query includes `assignedToId == myUserId`, so the list
      // is permitted; an unfiltered query from a rep is denied.)
      allow read: if isSuperAdmin()
        || (inWorkspace(resource.data.workspaceId) && role() in ['client_admin', 'manager', 'viewer'])
        || (isWsRep(resource.data.workspaceId) && resource.data.assignedToId == myUserId());

      // Always born as 'scheduled', signed by its creator, pointing at a real
      // lead of that same workspace. A viewer can never create.
      allow create: if validAppointmentShape()
        && request.resource.data.status == 'scheduled'
        && request.resource.data.createdBy == myUserId()
        && leadIsInSameWorkspace()
        && appointmentMatchesLead()
        && (
          isSuperAdmin()
          || isWsAdmin(request.resource.data.workspaceId)
          || (isWsRep(request.resource.data.workspaceId)
              && request.resource.data.assignedToId == myUserId()
              && repOwnsReferencedLead())
        );

      // Reschedule, cancel, complete. A rep may only touch their own meetings
      // and may not hand them to somebody else.
      allow update: if validAppointmentShape()
        && apptImmutablesKept()
        && (
          isSuperAdmin()
          || isWsAdmin(resource.data.workspaceId)
          || (isWsRep(resource.data.workspaceId)
              && resource.data.assignedToId == myUserId()
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedToId']))
        );

      allow delete: if isSuperAdmin() || isWsClientAdmin(resource.data.workspaceId);
    }

    // ---------------------------------------------------------- contentDrafts
    // Laboratorio de Contenido. A draft belongs to exactly ONE workspace and
    // is never readable from another. Internal drafts (strategy, angles,
    // prompts) are for admins/managers only; sales_rep and viewer see ONLY
    // creatives someone approved.
    match /contentDrafts/{draftId} {

      function validDraftStatus(v) {
        return v in ['draft', 'approved', 'archived'];
      }

      function validDraftObjective(v) {
        return v in ['sales', 'recruiting'];
      }

      /** Ownership and origin never change, not even for super_admin. */
      function draftImmutablesKept() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['workspaceId', 'createdBy', 'createdAt']);
      }

      /** Exact shape: no stray fields, no PII smuggled in. */
      function validDraftShape() {
        return request.resource.data.keys().hasAll([
              'workspaceId', 'createdBy', 'createdAt', 'updatedAt', 'objective',
              'channel', 'format', 'title', 'inputs', 'output', 'outputSource', 'status'
            ])
          && request.resource.data.keys().hasOnly([
              'workspaceId', 'createdBy', 'createdAt', 'updatedAt', 'objective',
              'channel', 'format', 'sourceCampaignId', 'title', 'inputs', 'output',
              'outputSource', 'variants', 'status', 'approvedBy', 'approvedAt'
            ])
          && request.resource.data.workspaceId is string
          && request.resource.data.workspaceId.size() > 0
          && request.resource.data.createdBy is string
          && request.resource.data.createdBy.size() > 0
          && request.resource.data.title is string
          && request.resource.data.inputs is map
          && request.resource.data.output is map
          && request.resource.data.outputSource in ['ai', 'template']
          && validDraftObjective(request.resource.data.objective)
          && validDraftStatus(request.resource.data.status);
      }

      // Admins and managers read everything in their workspace; reps and
      // viewers only approved creatives. Their client query must include
      // `status == 'approved'`, otherwise the list is denied.
      allow read: if isSuperAdmin()
        || isWsAdmin(resource.data.workspaceId)
        || ((isWsRep(resource.data.workspaceId)
             || (inWorkspace(resource.data.workspaceId) && role() == 'viewer'))
            && resource.data.status == 'approved');

      // A draft is always born as 'draft'. `createdBy` must be the caller's
      // own users.id, resolved from memberships/{request.auth.uid}: a client
      // cannot sign a draft as somebody else. `workspaceId` must be one the
      // caller administers (super_admin excepted, by design).
      allow create: if validDraftShape()
        && request.resource.data.status == 'draft'
        && request.resource.data.createdBy == myUserId()
        && !request.resource.data.keys().hasAny(['approvedBy', 'approvedAt'])
        && (isSuperAdmin() || isWsAdmin(request.resource.data.workspaceId));

      // Editing and approving: admins and managers of that workspace.
      // Archiving: client_admin only. Approval cannot smuggle a change of
      // workspace or author because draftImmutablesKept() blocks it.
      allow update: if validDraftShape()
        && draftImmutablesKept()
        && (
          isSuperAdmin()
          || (isWsAdmin(resource.data.workspaceId)
              && (request.resource.data.status != 'archived'
                  || isWsClientAdmin(resource.data.workspaceId)))
        );

      allow delete: if isSuperAdmin() || isWsClientAdmin(resource.data.workspaceId);
    }

    // ----------------------------------------------------- websiteIntegrations
    // One document per workspace: the website that posts leads to it. The
    // integration key lives here only as a SHA-256 hash and is written solely
    // by server routes with the Admin SDK — no client write is ever allowed,
    // so a hash, a domain or a status cannot be forged from the browser.
    match /websiteIntegrations/{wsId} {
      allow read: if isSuperAdmin() || isWsAdmin(wsId);
      allow write: if false;
    }

    // ----------------------------------------------------------- notifications
    // One document per recipient per event. Born in the SAME batch as the
    // lead it announces (client path) or by the Admin SDK (server paths).
    // A member reads only their own; the super admin reads them all. A
    // recipient may only flip `read`/`readAt`; nothing is ever deleted.
    match /notifications/{notificationId} {

      function notifiedLead() {
        return getAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data;
      }

      function recipientProfile() {
        return get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data;
      }

      function validNotificationShape() {
        return request.resource.data.keys().hasAll([
              'workspaceId', 'userId', 'type', 'leadId', 'leadType', 'title', 'message',
              'source', 'form', 'read', 'readAt', 'createdAt'
            ])
          && request.resource.data.keys().hasOnly([
              'workspaceId', 'userId', 'type', 'leadId', 'leadType', 'title', 'message',
              'source', 'form', 'read', 'readAt', 'createdAt'
            ])
          && request.resource.data.type == 'new_lead'
          && validLeadType(request.resource.data.leadType)
          && request.resource.data.read == false
          && request.resource.data.readAt == null
          && request.resource.data.workspaceId is string
          && request.resource.data.userId is string
          && request.resource.data.leadId is string;
      }

      allow read: if isSuperAdmin()
        || (hasMembership() && membershipIsActive() && resource.data.userId == myUserId());

      // Only alongside a lead that really exists in that workspace after the
      // batch, and only for a recipient who belongs to that same workspace.
      allow create: if validNotificationShape()
        && (isSuperAdmin() || isWsMember(request.resource.data.workspaceId))
        && existsAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId))
        && notifiedLead().workspaceId == request.resource.data.workspaceId
        && exists(/databases/$(database)/documents/users/$(request.resource.data.userId))
        && recipientProfile().workspaceId == request.resource.data.workspaceId;

      allow update: if hasMembership()
        && resource.data.userId == myUserId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);

      allow delete: if false;
    }

    // ------------------------------------------------------------ funnelEvents
    // Landing funnel steps. Written ONLY by the server route with the Admin
    // SDK, which resolves the workspace from the integration key — no client
    // write is ever allowed, so nobody can inflate another distributor's
    // funnel. Analysts of the workspace read them; Telemarketing does not
    // need marketing analytics and is not listed.
    match /funnelEvents/{eventId} {
      allow read: if isSuperAdmin() || isWsAdmin(resource.data.workspaceId);
      allow write: if false;
    }

    // --------------------------------------------------------------- customers
    // End customers ("Clientes finales") — the people who buy Royal Prestige.
    // NOT the `clients` collection, which holds commercial ACCOUNTS.
    //
    // `assignedToId` is the seller responsible TODAY and may be reassigned;
    // it is never the historical credit for a sale (that is `Sale.soldById`).
    match /customers/{customerId} {

      function customerImmutablesKept() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['workspaceId', 'createdBy', 'createdAt']);
      }

      /**
       * The assignee must be a real member of THIS workspace, or nobody.
       * `''` is the single representation of "unassigned", matching leads.
       */
      function assigneeExists() {
        return exists(/databases/$(database)/documents/users/$(request.resource.data.assignedToId));
      }

      function assigneeProfile() {
        return get(/databases/$(database)/documents/users/$(request.resource.data.assignedToId)).data;
      }

      function assigneeMembershipExists() {
        return exists(/databases/$(database)/documents/memberships/$(assigneeProfile().authUid));
      }

      function assigneeMembership() {
        return get(/databases/$(database)/documents/memberships/$(assigneeProfile().authUid)).data;
      }

      /**
       * Same reasoning as the seller check: a team profile is not proof of
       * access. A pending invitation has no membership, and a membership can
       * be revoked without the profile changing, so the membership decides.
       */
      function assigneeIsValid() {
        return request.resource.data.assignedToId == ''
          || (assigneeExists()
              && assigneeProfile().get('authUid', null) != null
              && assigneeProfile().workspaceId == request.resource.data.workspaceId
              && assigneeMembershipExists()
              && assigneeMembership().workspaceId == request.resource.data.workspaceId
              && assigneeMembership().get('status', 'active') != 'inactive');
      }

      function validCustomerShape() {
        return request.resource.data.keys().hasAll([
              'workspaceId', 'name', 'assignedToId', 'createdBy', 'createdAt', 'updatedAt'
            ])
          && request.resource.data.keys().hasOnly([
              'workspaceId', 'name', 'phone', 'email', 'address',
              'assignedToId', 'createdBy', 'createdAt', 'updatedAt'
            ])
          && request.resource.data.workspaceId is string
          && request.resource.data.workspaceId.size() > 0
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.assignedToId is string
          && request.resource.data.createdBy is string;
      }

      // A rep sees only their own book. Their query must include
      // `assignedToId == myUserId`, or Firestore denies the whole listing.
      allow read: if isSuperAdmin()
        || (inWorkspace(resource.data.workspaceId) && role() in ['client_admin', 'manager', 'viewer'])
        || (isWsRep(resource.data.workspaceId) && resource.data.assignedToId == myUserId());

      allow create: if validCustomerShape()
        && request.resource.data.createdBy == myUserId()
        && assigneeIsValid()
        && (
          isSuperAdmin()
          || isWsAdmin(request.resource.data.workspaceId)
          || (isWsRep(request.resource.data.workspaceId)
              && request.resource.data.assignedToId == myUserId())
        );

      // A rep may correct their customer's details but never hand them over:
      // reassignment is a manager decision.
      allow update: if validCustomerShape()
        && customerImmutablesKept()
        && assigneeIsValid()
        && (
          isSuperAdmin()
          || isWsAdmin(resource.data.workspaceId)
          || (isWsRep(resource.data.workspaceId)
              && resource.data.assignedToId == myUserId()
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedToId']))
        );

      allow delete: if isSuperAdmin() || isWsClientAdmin(resource.data.workspaceId);
    }

    // ------------------------------------------------------------------- sales
    // One confirmed purchase. A customer may buy many times.
    //
    // `soldById` is historical credit and never moves; reassigning the customer
    // must not rewrite who closed a past sale. In K1 a sale is effectively
    // immutable: only `notes` may change, so `amount` can never drift away from
    // the lead's `closedValue`.
    match /sales/{saleId} {

      function saleCustomer() {
        return get(/databases/$(database)/documents/customers/$(resource.data.customerId)).data;
      }

      function customerAfter() {
        return getAfter(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data;
      }

      /**
       * The customer may be born in the SAME transaction as this sale, so
       * `get()` would not see it: `getAfter()` is required here.
       */
      function customerAfterExists() {
        return existsAfter(/databases/$(database)/documents/customers/$(request.resource.data.customerId));
      }

      function customerAfterIsInSameWorkspace() {
        return customerAfterExists()
          && customerAfter().workspaceId == request.resource.data.workspaceId;
      }

      /** A repeat purchase has no lead; if one is named it must be a real sales lead. */
      function sourceLeadExists() {
        return exists(/databases/$(database)/documents/leads/$(request.resource.data.sourceLeadId));
      }

      function sourceLead() {
        return get(/databases/$(database)/documents/leads/$(request.resource.data.sourceLeadId)).data;
      }

      function sourceLeadIsValid() {
        return request.resource.data.sourceLeadId == null
          || (sourceLeadExists()
              && sourceLead().workspaceId == request.resource.data.workspaceId
              && sourceLead().get('leadType', 'sales') == 'sales');
      }

      function sellerProfile() {
        return get(/databases/$(database)/documents/users/$(request.resource.data.soldById)).data;
      }

      function sellerMembership() {
        return get(/databases/$(database)/documents/memberships/$(sellerProfile().authUid)).data;
      }

      /**
       * A team profile alone is NOT proof of membership: a pending invitation
       * has a profile with `authUid == null` and no membership, and a
       * membership can be revoked without the profile changing. The membership
       * is the authority, so it is what decides here.
       */
      function sellerExists() {
        return exists(/databases/$(database)/documents/users/$(request.resource.data.soldById));
      }

      function sellerMembershipExists() {
        return exists(/databases/$(database)/documents/memberships/$(sellerProfile().authUid));
      }

      function sellerIsValid() {
        return sellerExists()
          && sellerProfile().get('authUid', null) != null
          && sellerProfile().workspaceId == request.resource.data.workspaceId
          && sellerMembershipExists()
          && sellerMembership().workspaceId == request.resource.data.workspaceId
          && sellerMembership().get('status', 'active') != 'inactive'
          && sellerMembership().role in ['client_admin', 'manager', 'sales_rep'];
      }

      function validSaleShape() {
        return request.resource.data.keys().hasAll([
              'workspaceId', 'customerId', 'sourceLeadId', 'product', 'amount',
              'soldAt', 'soldById', 'status', 'createdBy', 'createdAt', 'updatedAt'
            ])
          && request.resource.data.keys().hasOnly([
              'workspaceId', 'customerId', 'sourceLeadId', 'product', 'amount',
              'soldAt', 'soldById', 'notes', 'status', 'createdBy', 'createdAt', 'updatedAt'
            ])
          && request.resource.data.workspaceId is string
          && request.resource.data.workspaceId.size() > 0
          && request.resource.data.customerId is string
          && request.resource.data.customerId.size() > 0
          && request.resource.data.product is string
          && request.resource.data.product.size() > 0
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.soldAt is string
          && request.resource.data.soldAt.size() > 0
          && request.resource.data.soldById is string
          && request.resource.data.status == 'confirmed'
          && request.resource.data.createdBy is string;
      }

      // The seller who currently attends the customer sees the whole history,
      // including sales closed by whoever had them before.
      allow read: if isSuperAdmin()
        || (inWorkspace(resource.data.workspaceId) && role() in ['client_admin', 'manager', 'viewer'])
        || (isWsRep(resource.data.workspaceId)
            && saleCustomer().workspaceId == resource.data.workspaceId
            && saleCustomer().assignedToId == myUserId());

      allow create: if validSaleShape()
        && request.resource.data.createdBy == myUserId()
        && sellerIsValid()
        && customerAfterIsInSameWorkspace()
        && sourceLeadIsValid()
        && (
          isSuperAdmin()
          || isWsAdmin(request.resource.data.workspaceId)
          // A rep credits only themselves, and only on their own customer.
          || (isWsRep(request.resource.data.workspaceId)
              && request.resource.data.soldById == myUserId()
              && customerAfter().assignedToId == myUserId())
        );

      // K1: notes only. `hasOnly` on the CHANGED keys freezes everything else,
      // including any field added later.
      allow update: if validSaleShape()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'updatedAt'])
        && (isSuperAdmin() || isWsAdmin(resource.data.workspaceId));

      allow delete: if isSuperAdmin() || isWsClientAdmin(resource.data.workspaceId);
    }

    // ------------------------------------------------------------------- leads
    match /leads/{leadId} {
      // Admins/managers/viewers read the whole workspace; reps only their own.
      // (The client query for reps includes `assignedToId == myUserId`, so the
      // list is permitted; an unfiltered query from a rep is denied.)
      allow read: if isSuperAdmin()
        || (inWorkspace(resource.data.workspaceId) && role() in ['client_admin', 'manager', 'viewer'])
        || (isWsRep(resource.data.workspaceId) && resource.data.assignedToId == myUserId());

      /**
       * Closing data (`closedValue` / `closedAt`) may only appear through a
       * REAL transition into the won stage, and must disappear when the lead
       * leaves it. The authoritative moment of the close is the server-signed
       * `stage_change` activity; these rules guarantee the lead can never hold
       * incoherent closing data.
       */
      function wonStageOf(type) {
        return type == 'sales' ? 'sale' : 'rec_hired';
      }

      /** Legacy docs may lack `leadType`; they were migrated as sales. */
      function leadTypeBefore() {
        return resource.data.get('leadType', 'sales');
      }

      function wasWon() {
        return resource.data.stage == wonStageOf(leadTypeBefore());
      }

      function isWonNow() {
        return request.resource.data.stage == wonStageOf(request.resource.data.leadType);
      }

      /** A field counts as absent when it is missing or explicitly null. */
      function hasClosedValue() {
        return request.resource.data.get('closedValue', null) != null;
      }

      function hasClosedAt() {
        return request.resource.data.get('closedAt', null) != null;
      }

      function closedValueIsValid() {
        return request.resource.data.closedValue is number
            && request.resource.data.closedValue > 0;
      }

      function closingDataChanged() {
        return changedKeys().hasAny(['closedValue', 'closedAt']);
      }

      function closingInvariants() {
        //  1. A hire is not revenue: recruiting never carries an amount.
        return (request.resource.data.leadType == 'sales' || !hasClosedValue())
        //  2. Closing data only moves on a real won transition.
        && (!closingDataChanged() || !wasWon() == isWonNow())
        //  3. Entering the won stage: a sale needs a positive amount and a
        //     date; a hire needs the date and no amount.
        && ((wasWon() || !isWonNow()) || (
              request.resource.data.leadType == 'sales'
                ? (closedValueIsValid() && hasClosedAt())
                : (!hasClosedValue() && hasClosedAt())
            ))
        //  4. Leaving the won stage clears both, in the same write.
        && ((!wasWon() || isWonNow()) || (!hasClosedValue() && !hasClosedAt()))
        //  5. A lead outside its won stage never holds closing data.
        && (isWonNow() || (!hasClosedValue() && !hasClosedAt()));
      }

      /**
       * Link to the end customer. Absent or '' both mean "not converted yet";
       * `get(..., '')` collapses them so there is one comparison.
       */
      function customerIdBefore() {
        return resource.data.get('customerId', '');
      }

      function customerIdAfter() {
        return request.resource.data.get('customerId', '');
      }

      /**
       * Write-once: from empty to a value, never from customer A to customer B
       * and never back to empty. A lead converts into ONE buyer, for good.
       */
      function customerLinkIsWriteOnce() {
        return customerIdBefore() == customerIdAfter()
            || (customerIdBefore() == '' && customerIdAfter().size() > 0);
      }

      /**
       * The customer is created in the SAME transaction as this update, so
       * `get()` would not see it yet — `getAfter()` is required.
       */
      function linkedCustomerExists() {
        return existsAfter(/databases/$(database)/documents/customers/$(customerIdAfter()));
      }

      function linkedCustomer() {
        return getAfter(/databases/$(database)/documents/customers/$(customerIdAfter())).data;
      }

      function linkedCustomerIsValid() {
        return linkedCustomerExists()
          && linkedCustomer().workspaceId == request.resource.data.workspaceId;
      }

      /**
       * The link may only appear at the MOMENT of the close: not won before,
       * won now. A lead already sitting in `sale` can never gain a customer
       * afterwards — that path would let anyone attach an arbitrary buyer to a
       * closed deal. Legacy closed leads without a link stay unlinked; that is
       * an administrative migration, not something the app may do.
       */
      function customerLinkOnlyOnRealClose() {
        return customerIdBefore() == customerIdAfter()
            || (
              customerIdBefore() == ''
              && resource.data.stage != 'sale'
              && request.resource.data.stage == 'sale'
              && request.resource.data.leadType == 'sales'
              && linkedCustomerIsValid()
            );
      }

      // New leads must declare their type AND a stage of that type's pipeline.
      // Access is still decided exclusively by workspaceId / role / assignedToId.
      // A lead is never born closed: closing data can only appear later, on a
      // real transition into the won stage.
      allow create: if validLeadType(request.resource.data.leadType)
        && stageMatchesType(request.resource.data.leadType, request.resource.data.stage)
        && !request.resource.data.keys().hasAny(['closedValue', 'closedAt'])
        // A lead is never born converted: the link only appears on a close.
        && !request.resource.data.keys().hasAny(['customerId'])
        && (
          isSuperAdmin()
          || isWsAdmin(request.resource.data.workspaceId)
          || (isWsRep(request.resource.data.workspaceId)
              && request.resource.data.assignedToId == myUserId())
        );

      // Updates must keep the document coherent, whoever writes them:
      //  1. leadType valid and stage belonging to that pipeline;
      //  2. ownership and origin are immutable (also for super_admin) —
      //     workspaceId, source, attribution, createdAt, clientId;
      //  3. leadType may only change through the authorised flow, which resets
      //     the stage to that pipeline's initial stage, and only for admins;
      //  4. the role checks are exactly the previous ones, plus: a rep may not
      //     reassign the lead nor change its type.
      allow update: if validLeadType(request.resource.data.leadType)
        && stageMatchesType(request.resource.data.leadType, request.resource.data.stage)
        && !changedKeys().hasAny(['workspaceId', 'source', 'attribution', 'createdAt', 'clientId'])
        && closingInvariants()
        && customerLinkIsWriteOnce()
        && customerLinkOnlyOnRealClose()
        && (
          !changedKeys().hasAny(['leadType'])
          || (
            (isSuperAdmin() || isWsAdmin(resource.data.workspaceId))
            && request.resource.data.stage == initialStageFor(request.resource.data.leadType)
          )
        )
        && (
          isSuperAdmin()
          || isWsAdmin(resource.data.workspaceId)
          || (isWsRep(resource.data.workspaceId)
              && resource.data.assignedToId == myUserId()
              && !changedKeys().hasAny(['assignedToId', 'leadType']))
        );

      allow delete: if isSuperAdmin() || isWsAdmin(resource.data.workspaceId);
    }

    // ------------------------------------------------- leads/{id}/activities
    // Immutable audit trail. An activity may only be written together with the
    // change it describes, in the SAME batch: `get()` sees the lead before the
    // batch, `getAfter()` after it, so the rule can require a real transition.
    match /leads/{leadId}/activities/{activityId} {

      /** Lead state BEFORE this write. Only valid when the lead already exists. */
      function leadBefore() {
        return get(/databases/$(database)/documents/leads/$(leadId)).data;
      }

      /** Lead state AFTER this batch. Sees a lead created in the same batch. */
      function leadAfter() {
        return getAfter(/databases/$(database)/documents/leads/$(leadId)).data;
      }

      function leadExistedBefore() {
        return exists(/databases/$(database)/documents/leads/$(leadId));
      }

      function activity() {
        return request.resource.data;
      }

      function activityPayload() {
        return activity().get('payload', {});
      }

      /** Reads use the CURRENT lead: getAfter() is not allowed on reads. */
      function canSeeLead() {
        return isSuperAdmin()
          || (inWorkspace(leadBefore().workspaceId) && role() in ['client_admin', 'manager', 'viewer'])
          || (isWsRep(leadBefore().workspaceId) && leadBefore().assignedToId == myUserId());
      }

      /** Writes use the RESULTING lead, so a lead born in this batch counts. */
      function canActOnLead() {
        return isSuperAdmin()
          || isWsAdmin(leadAfter().workspaceId)
          || (isWsRep(leadAfter().workspaceId) && leadAfter().assignedToId == myUserId());
      }

      function validActivityType(v) {
        return v in ['whatsapp', 'call', 'stage_change', 'assignment_change',
                     'note', 'lead_created', 'archived', 'restored'];
      }

      /**
       * Audit snapshot of the actor's ROLE at the time of the action. Needed
       * because the super admin has no `users` profile inside a workspace, so
       * the name cannot always be resolved. It is pinned to the caller's real
       * role in `memberships/{uid}`, so it cannot be faked.
       */
      function validActorRole(v) {
        return v in ['super_admin', 'client_admin', 'manager', 'sales_rep', 'viewer'];
      }

      /** Exact shape: no extra fields, correct types, server-signed timestamp. */
      function validShape() {
        return activity().keys().hasOnly(['workspaceId', 'leadId', 'type', 'actorId', 'actorRole', 'createdAt', 'createdAtServer', 'payload'])
          && activity().keys().hasAll(['workspaceId', 'leadId', 'type', 'actorId', 'actorRole', 'createdAt', 'createdAtServer'])
          && activity().workspaceId is string
          && activity().leadId is string
          && activity().type is string
          && validActivityType(activity().type)
          && activity().actorId is string
          && activity().actorRole is string
          && validActorRole(activity().actorRole)
          && activity().createdAt is string
          && activity().createdAt.size() > 0
          && activity().createdAtServer is timestamp
          && activity().createdAtServer == request.time
          && activityPayload() is map
          && activityPayload().keys().hasOnly(['from', 'to', 'fromLabel', 'toLabel', 'note']);
      }

      /**
       * An activity must describe a change that really happened in this batch.
       * 'note' is the only type that does not modify the lead.
       */
      function describesRealChange() {
        return activity().type == 'lead_created'
            ? (!leadExistedBefore() && existsAfter(/databases/$(database)/documents/leads/$(leadId)))
          : activity().type == 'stage_change'
            ? (leadExistedBefore()
               && leadBefore().stage != leadAfter().stage
               && activityPayload().get('from', '') == leadBefore().stage
               && activityPayload().get('to', '') == leadAfter().stage)
          : activity().type == 'assignment_change'
            ? (leadExistedBefore()
               && leadBefore().get('assignedToId', '') != leadAfter().get('assignedToId', '')
               && activityPayload().get('from', '') == leadBefore().get('assignedToId', '')
               && activityPayload().get('to', '') == leadAfter().get('assignedToId', ''))
          : activity().type == 'archived'
            ? (leadExistedBefore()
               && leadBefore().get('archived', false) != true
               && leadAfter().get('archived', false) == true)
          : activity().type == 'restored'
            ? (leadExistedBefore()
               && leadBefore().get('archived', false) == true
               && leadAfter().get('archived', false) != true)
          : (activity().type == 'whatsapp' || activity().type == 'call')
            ? (leadExistedBefore()
               && leadBefore().get('lastContactAt', null) != leadAfter().get('lastContactAt', null))
          : leadExistedBefore();
      }

      /** A note must carry real text, not blanks. */
      function validNote() {
        return activity().type != 'note'
          || (activityPayload().get('note', '') is string
              && activityPayload().get('note', '').trim().size() > 0);
      }

      allow read: if canSeeLead();

      allow create: if validShape()
        && validNote()
        && activity().leadId == leadId
        && activity().actorId == myUserId()
        // The role is not chosen by the client: it must be the caller's real one.
        && activity().actorRole == role()
        && existsAfter(/databases/$(database)/documents/leads/$(leadId))
        && activity().workspaceId == leadAfter().workspaceId
        && describesRealChange()
        && canActOnLead();

      // Audit trail: never edited, never deleted.
      allow update, delete: if false;
    }

    // ----------------------------------------------------- everything else
    // Any collection not listed above is closed. Add explicit rules when a new
    // collection is introduced (appointments, activities, integrations, …).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
