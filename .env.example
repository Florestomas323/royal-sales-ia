# ---------------------------------------------------------------------------
# Royal Sales IA — Environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values for your own Firebase
# project. Never commit `.env.local` (it is gitignored).
#
# These NEXT_PUBLIC_* values come from your Firebase project settings:
#   Firebase Console → Project settings → General → Your apps → Web app → SDK setup
#
# They are Firebase *web* config values and are public by design. Real security
# is enforced by Firebase Authentication + Firestore Security Rules, not by
# hiding these keys.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# FUTURE / ROADMAP — do NOT add these yet. They belong on the SERVER only
# (never NEXT_PUBLIC_, never committed). Listed here purely as a reference for
# when the corresponding integrations are built.
# ---------------------------------------------------------------------------

# Firebase Admin SDK (server-side only — service account)
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# Meta Marketing / Lead Ads / Conversions API (server-side only)
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=

# TikTok Marketing / Events API (server-side only)
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# TIKTOK_ACCESS_TOKEN=

# WhatsApp Business Platform (server-side only)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=

# AI provider (server-side only)
# OPENAI_API_KEY=
