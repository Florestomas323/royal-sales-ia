  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-build",
    "jsx": "react-jsx",
    "declaration": false,
    "skipLibCheck": true
  },
  "include": [
